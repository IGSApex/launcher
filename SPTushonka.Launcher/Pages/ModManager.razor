@page "/ModManager"
@using System.IO
@using System.Linq
@using System.Security.Cryptography
@inject NavigationManager NavigationManager
@inject StateHelper StateHelper
@inject ConfigHelper ConfigHelper
@inject HttpHelper HttpHelper
@inject ISnackbar Snackbar

<MudContainer Class="px-4 my-2" MaxWidth="MaxWidth.Large">
    <MudContainer Class="pa-0 d-flex justify-start gap-2 pb-4">
        <MudButton Class="mud-button-border-copy border-2 border-solid mud-button-inner-text-copy"
                   Color="Color.Dark" StartIcon="@Icons.Material.Filled.ArrowBack" IconColor="Color.Error"
                   Variant="Variant.Filled" Size="Size.Medium" OnClick="GoBack">BACK</MudButton>
    </MudContainer>

    <MudContainer Class="pa-0 d-flex justify-end gap-2 pb-4">
        <MudButton Color="Color.Dark" StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Filled"
                   OnClick="Reload" Disabled="_loading">REFRESH</MudButton>
        <MudButton Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" Variant="Variant.Filled"
                   OnClick="UpdateMods" Disabled="@(_loading || _serverMessage != null || _serverMods.Count == 0)">UPDATE MODS TO MATCH SERVER</MudButton>
    </MudContainer>

    <MudPaper Class="pa-3 border-2 border-solid mud-border-lines-default card-container" Elevation="2">
        <MudGrid Spacing="2">
            <MudItem xs="6">
                <MudText Typo="Typo.h6">Server Required Client Mods</MudText>
            </MudItem>
            <MudItem xs="6">
                <MudText Typo="Typo.h6">Your Client Mods</MudText>
            </MudItem>
        </MudGrid>
        <MudDivider Class="my-3"/>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small"/>
        }
        else if (_serverMods.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                @(_serverMessage ?? "No client mods are published by this server.")
            </MudAlert>
        }
        else
        {
            @foreach (var mod in _serverMods)
            {
                var local = _localMods.FirstOrDefault(x => x.Path.Equals(mod.FileName, StringComparison.OrdinalIgnoreCase));
                var matches = local != null && local.Hash.Equals(mod.Sha256, StringComparison.OrdinalIgnoreCase);
                <MudGrid Spacing="2" Class="py-1">
                    <MudItem xs="6">
                        <MudPaper Class="pa-2" Elevation="1">
                            <MudText Typo="Typo.body2">@mod.Name - V@(FormatVersion(mod.Version))</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@mod.FileName</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6">
                        <MudPaper Class="pa-2" Elevation="1">
                            <MudText Typo="Typo.body2">
                                @mod.Name -
                                <span style="color:@(matches ? "inherit" : "#f44336")">
                                    @(local is null ? "Not Installed" : "V" + FormatVersion(local.Version))
                                </span>
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@(local?.Path ?? "Missing")</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            }
            @if (_extraMods.Count > 0)
            {
                <MudDivider Class="my-3"/>
                <MudText Typo="Typo.subtitle2">Additional Client Mods</MudText>
                @foreach (var extra in _extraMods)
                {
                    <MudText Typo="Typo.body2">@extra.Path - V@(FormatVersion(extra.Version))</MudText>
                }
            }
        }
    </MudPaper>

</MudContainer>

@code {
    private sealed class ClientModEntry
    {
        public string Name { get; set; } = "";
        public string Version { get; set; } = "";
        public string FileName { get; set; } = "";
        public long Size { get; set; }
        public string Sha256 { get; set; } = "";
    }

    // Standard SPT client modules are part of the base installation, not optional mods.
    private static readonly HashSet<string> BuiltInPlugins = new(StringComparer.OrdinalIgnoreCase)
    {
        "spt-common.dll",
        "spt-core.dll",
        "spt-custom.dll",
        "spt-debugging.dll",
        "spt-reflection.dll",
        "spt-singleplayer.dll",
        "ConfigurationManager.dll"
    };

    private static bool IsBuiltInPlugin(string relativePath)
    {
        var parts = relativePath.Replace('\\', '/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 &&
               parts[0].Equals("spt", StringComparison.OrdinalIgnoreCase) &&
               BuiltInPlugins.Contains(parts[^1]);
    }

    private sealed class LocalModEntry
    {
        public string Path { get; set; } = "";
        public string Version { get; set; } = "";
        public string Hash { get; set; } = "";
    }

    private static string FormatVersion(string? version) =>
        string.IsNullOrWhiteSpace(version) ? "Unknown" : version;

    private readonly List<LocalModEntry> _localMods = [];
    private readonly List<LocalModEntry> _extraMods = [];
    private List<ClientModEntry> _serverMods = [];
    private bool _loading;
    private string? _serverMessage;

    protected override async Task OnInitializedAsync()
    {
        if (StateHelper.SelectedServer is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }
        await Reload();
    }

    private void GoBack() => NavigationManager.NavigateTo("/Profiles");

    private static bool IsSafeModPath(string relative)
    {
        var parts = relative.Replace('\\', '/').Split('/');
        if (parts.Length < 2 || !(parts[0].Equals("plugins", StringComparison.OrdinalIgnoreCase) ||
                                  parts[0].Equals("patchers", StringComparison.OrdinalIgnoreCase)) ||
            parts.Any(x => x is "" or "." or ".." || x.Contains(':') || x.Contains('\\')))
            return false;
        var path = string.Join("/", parts);
        return !path.StartsWith("plugins/spt/", StringComparison.OrdinalIgnoreCase) &&
               !path.Equals("patchers/spt-prepatch.dll", StringComparison.OrdinalIgnoreCase) &&
               !path.Equals("patchers/FixPluginTypesSerialization.dll", StringComparison.OrdinalIgnoreCase);
    }

    private async Task UpdateMods()
    {
        if (_loading || _serverMessage != null || _serverMods.Count == 0) return;
        _loading = true;
        try
        {
            var folder = Path.GetFullPath(Path.Combine(ConfigHelper.GetGamePath(), "BepInEx"));
            Directory.CreateDirectory(folder);
            foreach (var mod in _serverMods)
            {
                if (string.IsNullOrWhiteSpace(mod.FileName) || !IsSafeModPath(mod.FileName) ||
                    mod.Size <= 0 || mod.Sha256.Length != 64 || !mod.Sha256.All(Uri.IsHexDigit))
                    throw new InvalidDataException("Invalid server mod entry: " + mod.Name);
                var destination = Path.GetFullPath(Path.Combine(folder, mod.FileName.Replace('/', Path.DirectorySeparatorChar)));
                Directory.CreateDirectory(Path.GetDirectoryName(destination)!);
                if (File.Exists(destination) && await HashMatches(destination, mod.Sha256)) continue;
                var staging = destination + ".download";
                try
                {
                    await HttpHelper.DownloadFileAsync("/files/client-mod/" + string.Join("/", mod.FileName.Split('/').Select(Uri.EscapeDataString)),
                        staging, null, CancellationToken.None);
                    if (new FileInfo(staging).Length != mod.Size || !await HashMatches(staging, mod.Sha256))
                        throw new InvalidDataException("Integrity check failed: " + mod.FileName);
                    if (File.Exists(destination)) File.Copy(destination, destination + ".backup", true);
                    File.Move(staging, destination, true);
                }
                finally { if (File.Exists(staging)) File.Delete(staging); }
            }
            Snackbar.Add("Client mods updated. Restart the game to load changes.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add("Mod update failed: " + ex.Message, Severity.Error); }
        finally { _loading = false; await Reload(); }
    }

    private static async Task<bool> HashMatches(string file, string expected)
    {
        await using var stream = File.OpenRead(file);
        var hash = Convert.ToHexString(await SHA256.HashDataAsync(stream));
        return hash.Equals(expected, StringComparison.OrdinalIgnoreCase);
    }

    private async Task Reload()
    {
        _loading = true;
        _localMods.Clear();
        _extraMods.Clear();
        _serverMods = [];
        _serverMessage = null;
        try
        {
            var bepInExFolder = Path.Combine(ConfigHelper.GetGamePath(), "BepInEx");
            foreach (var kind in new[] { "plugins", "patchers" })
            {
                var directory = Path.Combine(bepInExFolder, kind);
                if (!Directory.Exists(directory)) continue;
                foreach (var file in Directory.EnumerateFiles(directory, "*", SearchOption.AllDirectories))
                {
                    var relative = Path.GetRelativePath(bepInExFolder, file).Replace('\\', '/');
                    if (!IsSafeModPath(relative)) continue;
                    await using var stream = File.OpenRead(file);
                    _localMods.Add(new LocalModEntry
                    {
                        Path = relative,
                        Version = System.Diagnostics.FileVersionInfo.GetVersionInfo(file).FileVersion ?? "",
                        Hash = Convert.ToHexString(await SHA256.HashDataAsync(stream))
                    });
                }
            }
            // This endpoint must be implemented server-side before sync can be enabled.
            try
            {
                _serverMods = await HttpHelper.GameServerGet<List<ClientModEntry>>(
                    "/launcher/v2/client-mods", CancellationToken.None) ?? [];
                var required = new HashSet<string>(_serverMods.Select(x => x.FileName), StringComparer.OrdinalIgnoreCase);
                _extraMods.AddRange(_localMods.Where(x => !required.Contains(x.Path)).OrderBy(x => x.Path));
            }
            catch (Exception)
            {
                _serverMessage = "Server client-mod manifest is not available yet.";
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Unable to scan installed mods: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
