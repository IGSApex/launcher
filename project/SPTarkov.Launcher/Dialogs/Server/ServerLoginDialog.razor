@inject ISnackbar Snackbar
@inject StateHelper StateHelper
@inject SessionHelper SessionHelper
@inject LauncherAccountHelper Accounts
@inject LocaleHelper LocaleHelper

<MudDialog Class="mud-background-gray border-2 border-solid mud-border-lines-default">
    <DialogContent>
        <MudContainer Class="py-4 d-flex flex-column gap-3">
            <MudText Typo="Typo.h6">@Server.Name — Launcher Account</MudText>
            @if (_busy)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary"/>
                <MudText>@_status</MudText>
            }
            else if (!_connected)
            {
                <MudText Color="Color.Error">Unable to connect to this server. Please check the server and try again.</MudText>
                <MudButton OnClick="Cancel">Close</MudButton>
            }
            else if (StateHelper.ServerRequiresPassword)
            {
                <MudTextField @bind-Value="_username" Label="Username" Variant="Variant.Outlined" Required="true"/>
                <MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" Required="true"/>
                @if (_register)
                {
                    <MudTextField @bind-Value="_confirm" Label="Confirm password" InputType="InputType.Password" Variant="Variant.Outlined" Required="true"/>
                }
                <div class="d-flex gap-2">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!CanSubmit)">@(_register ? "Register" : "Login")</MudButton>
                    <MudButton OnClick="ToggleMode">@(_register ? "Back to login" : "Register")</MudButton>
                    <MudButton Disabled="true">Forgot Password (Coming Soon)</MudButton>
                    <MudButton OnClick="Cancel">Cancel</MudButton>
                </div>
            }
        </MudContainer>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public Server Server { get; set; } = default!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private string _username = "";
    private string _password = "";
    private string _confirm = "";
    private string _status = "";
    private bool _busy;
    private bool _connected;

    protected override async Task OnInitializedAsync()
    {
        _busy = true;
        _status = "Checking server settings...";
        try
        {
            var result = await SessionHelper.ConnectToServerAsync(Server);
            _connected = result.Success;
            if (!_connected) Snackbar.Add("Server connection failed: " + result.FailedStep, Severity.Error);
            else if (!StateHelper.ServerRequiresPassword) MudDialog.Close(DialogResult.Ok(Server));
        }
        finally { _busy = false; }
    }
    private bool _register;
    private bool CanSubmit => !string.IsNullOrWhiteSpace(_username) && _password.Length >= 8 && (!_register || _confirm == _password);

    private void ToggleMode() { _register = !_register; _password = ""; _confirm = ""; }
    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (!CanSubmit || _busy) return;
        _busy = true;
        try
        {
            _status = "Connecting to server...";
            if (!_connected) return;
            if (!StateHelper.ServerRequiresPassword)
            {
                MudDialog.Close(DialogResult.Ok(Server));
                return;
            }
            if (_register)
            {
                _status = "Creating launcher account...";
                if (!await Accounts.RegisterAsync(_username, _password))
                {
                    Snackbar.Add("Launcher account registration failed.", Severity.Error);
                    return;
                }
            }
            _status = "Authenticating launcher account...";
            if (!await Accounts.LoginAsync(_username, _password))
            {
                Snackbar.Add("Invalid launcher account credentials.", Severity.Error);
                return;
            }
            _status = "Loading owned profiles...";
            if (!await Accounts.RefreshProfilesAsync())
            {
                Snackbar.Add("Unable to load account profiles.", Severity.Error);
                await Accounts.LogoutAsync();
                return;
            }
            MudDialog.Close(DialogResult.Ok(Server));
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to connect or authenticate with this server.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
